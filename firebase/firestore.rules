rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // TODO: Replace email-based admin checks with custom claims or /admins/{uid} docs.
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['jazzhjm@gmail.com'];
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(fields);
    }

    function hasOnlyAllowedRatingFields() {
      return request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'matchId', 'score', 'createdAt']);
    }

    function isValidRatingCreate(ratingId) {
      return verifiedEmail()
        && hasOnlyAllowedRatingFields()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.matchId is string
        && request.resource.data.score is number
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        && ratingId == request.resource.data.fromUid + '_' + request.resource.data.toUid + '_' + request.resource.data.matchId;
    }

    function isRatingAggregateCreate() {
      return verifiedEmail()
        && request.resource.data.keys().hasOnly(['rateCount', 'rateTotal', 'updatedAt'])
        && request.resource.data.rateCount == 1
        && request.resource.data.rateTotal is number
        && request.resource.data.rateTotal >= 1
        && request.resource.data.rateTotal <= 5;
    }

    function isRatingAggregateUpdate() {
      return verifiedEmail()
        && changedOnly(['rateCount', 'rateTotal', 'updatedAt'])
        && request.resource.data.rateCount == resource.data.rateCount + 1
        && request.resource.data.rateTotal is number
        && resource.data.rateTotal is number
        && request.resource.data.rateTotal >= resource.data.rateTotal + 1
        && request.resource.data.rateTotal <= resource.data.rateTotal + 5;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) || isAdmin() || isRatingAggregateCreate();
      allow update: if isOwner(userId) || isAdmin() || isRatingAggregateUpdate();
      allow delete: if isAdmin();
    }

    match /parties/{partyId} {
      allow read: if true;
      allow create: if verifiedEmail()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.deleted == false;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if verifiedEmail()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
    }

    match /community/{postId} {
      allow read: if true;
      allow create: if verifiedEmail()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && changedOnly(['likes', 'updatedAt']))
        || (signedIn() && changedOnly(['commentCount', 'updatedAt'])
          && request.resource.data.commentCount == resource.data.commentCount + 1);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if verifiedEmail()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /presences/{presenceId} {
      allow read: if true;
      allow create, update: if signedIn() || presenceId.matches('guest_.*');
      allow delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isValidRatingCreate(ratingId);
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if verifiedEmail()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
